# Copy to .env and keep it private. Existing Telegram variable names remain supported.
ADMIN_PASSWORD_HASH=
# With Docker Compose, enclose the complete hash in single quotes to preserve '$'.
# Generate a hash: python -m backend.cli hash-password
# For local development only, ADMIN_PASSWORD can be used instead of the hash.
TELEPORT_DATA_DIR=./data
TELEPORT_TIMEZONE=Europe/Rome
# Set true behind HTTPS on the VPS; false only for local HTTP preview.
TELEPORT_COOKIE_SECURE=false
TELEPORT_SESSION_HOURS=12
# Optional Fernet key; otherwise generated once in data/encryption.key. Back it up.
TELEPORT_SECRET_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=./data/telegram
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
TELEPORT_ANALYSIS_LIMIT=100
TELEPORT_ANALYSIS_REQUEST_LIMIT=100
# Pausa tra due momenti, in minuti (5–240). Riavvia dopo una modifica.
TELEPORT_MOMENT_GAP_MINUTES=30
# Explicit fictional-data preview only. Use a separate data directory.
TELEPORT_DEMO=false
TELEPORT_RUN_WORKER=true
